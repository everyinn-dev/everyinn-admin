{
  "name": "everyinn-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv env.d.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:migrate:local": "wrangler d1 execute everyinn-admin --local --file=./db/migrations/001_tables.sql",
    "db:seed:local": "wrangler d1 execute everyinn-admin --local --file=./db/migrations/002_seed.sql",
    "db:migrate:003:local": "wrangler d1 execute everyinn-admin --local --file=./db/migrations/003_refactor_rooms_pricing.sql",
    "db:migrate:004:local": "wrangler d1 execute everyinn-admin --local --file=./db/migrations/004_add_config_hourly_slots.sql",
    "db:migrate:005:local": "wrangler d1 execute everyinn-admin --local --file=./db/migrations/005_import_sheet_bookings.sql",
    "db:migrate:006:local": "wrangler d1 execute everyinn-admin --local --file=./db/migrations/006_add_social_and_closing_note.sql",
    "db:migrate:remote": "wrangler d1 execute everyinn-admin --remote -y --file=./db/migrations/001_tables.sql",
    "db:seed:remote": "wrangler d1 execute everyinn-admin --remote -y --file=./db/migrations/002_seed.sql",
    "db:migrate:003:remote": "wrangler d1 execute everyinn-admin --remote -y --file=./db/migrations/003_refactor_rooms_pricing.sql",
    "db:migrate:004:remote": "wrangler d1 execute everyinn-admin --remote -y --file=./db/migrations/004_add_config_hourly_slots.sql",
    "db:migrate:005:remote": "wrangler d1 execute everyinn-admin --remote -y --file=./db/migrations/005_import_sheet_bookings.sql",
    "db:migrate:006:remote": "wrangler d1 execute everyinn-admin --remote -y --file=./db/migrations/006_add_social_and_closing_note.sql"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.14.0",
    "bcryptjs": "^3.0.3",
    "next": "^16.0.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "wrangler": "^4.127.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.0.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
