{
  "name": "everyinn-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test \"test/**/*.test.mjs\"",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv env.d.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "echo 'Direct laptop deploy disabled. Deploys are managed by Cloudflare Workers Builds via dev/main branch pushes.' && exit 1",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:dev": "wrangler d1 migrations apply DB --env dev --remote",
    "db:migrate:prod": "wrangler d1 migrations apply DB --env=\"\" --remote",
    "cf:build": "npm run lint && tsc --noEmit && opennextjs-cloudflare build",
    "cf:deploy": "wrangler deploy --env=\"\"",
    "cf:deploy:dev": "wrangler deploy --env dev"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.14.0",
    "bcryptjs": "^3.0.3",
    "next": "^16.0.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "wrangler": "^4.127.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.0.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
